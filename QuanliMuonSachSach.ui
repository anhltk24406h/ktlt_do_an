        <property name="styleSheet">
         <string notr="true">QComboBox {
    background-color: white;  /* Nền trắng */
    border: 2px solid #0078D7;  /* Viền xanh đậm */
    border-radius: 5px;  /* Bo góc */
    padding: 5px;  /* Khoảng cách bên trong */
    font-size: 16px;  /* Cỡ chữ to hơn */
    color: black;  /* Màu chữ đen */
}

QComboBox::drop-down {
    border: none;
    background-color: white;  /* Nền dropdown */
    width: 25px;  /* Tăng kích thước khu vực dropdown */
}

QComboBox::down-arrow {
    image: url(down-arrow.png);  /* Đổi icon mũi tên nếu cần */
    width: 16px;  /* Tăng kích thước mũi tên */
    height: 16px;
    margin-right: 5px;  /* Khoảng cách với viền phải */
}

QComboBox QAbstractItemView {
    background: white;
    selection-background-color: #0078D7;  /* Màu nền khi chọn */
    selection-color: white;  /* Chữ trắng khi chọn */
    border-radius: 5px;
    font-size: 16px;  /* Cỡ chữ trong danh sách */
}
</string>
